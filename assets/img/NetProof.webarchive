bplist00“_WebMainResource_WebSubframeArchives’	
_WebResourceTextEncodingName_WebResourceData_WebResourceMIMEType_WebResourceFrameName^WebResourceURLUUTF-8OüÔ<!DOCTYPE html><html lang="en" data-zotero-connector-injected="true" data-lastpass-safe-prompts-active=""><head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>NetProof</title>
<style>
:root{
  --bg:#f4f5f7; --card:#fff; --ink:#1b1f24; --mute:#626b76; --line:#dde1e6;
  --accent:#2563eb; --accent-ink:#fff;
  --good:#15803d; --good-bg:#dcfce7; --fair:#b45309; --fair-bg:#fef3c7; --poor:#b91c1c; --poor-bg:#fee2e2;
  --chart:#2563eb; --chart2:#9333ea; --chart3:#0d9488;
}
@media (prefers-color-scheme: dark){
  :root{
    --bg:#111418; --card:#1a1e24; --ink:#e8eaed; --mute:#9aa3ad; --line:#2c323a;
    --accent:#3b82f6; --good:#4ade80; --good-bg:#14301f; --fair:#fbbf24; --fair-bg:#3a2c0d; --poor:#f87171; --poor-bg:#3b1515;
    --chart:#60a5fa; --chart2:#c084fc; --chart3:#2dd4bf;
  }
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.45 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
main{max-width:860px;margin:0 auto;padding:20px 16px 60px}
header{display:flex;align-items:baseline;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:16px}
h1{font-size:26px;margin:0;letter-spacing:-.02em}
h1 span{color:var(--accent)}
.me{color:var(--mute);font-size:14px}
.card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:18px;margin-bottom:14px}
h2{font-size:13px;text-transform:uppercase;letter-spacing:.06em;color:var(--mute);margin:0 0 12px;font-weight:600}
.step{display:inline-flex;width:22px;height:22px;border-radius:50%;background:var(--accent);color:var(--accent-ink);font-size:12px;align-items:center;justify-content:center;margin-right:8px;vertical-align:1px}
select,input{font:inherit;color:var(--ink);background:var(--bg);border:1px solid var(--line);border-radius:8px;padding:9px 11px;width:100%}
button{font:inherit;font-weight:600;border:0;border-radius:8px;padding:10px 18px;background:var(--accent);color:var(--accent-ink);cursor:pointer;white-space:nowrap}
button.ghost{background:transparent;color:var(--accent);border:1px solid var(--line)}
button:disabled{opacity:.5;cursor:default}
.row{display:flex;gap:10px;align-items:center}
.peer{display:flex;align-items:center;gap:12px;padding:10px 0;border-top:1px solid var(--line)}
.peer:first-child{border-top:0}
.peer .n{flex:1;min-width:0}
.peer .n b{display:block;overflow:hidden;text-overflow:ellipsis}
.peer .n small{color:var(--mute)}
.dot{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:7px;background:var(--line);vertical-align:1px}
.dot.on{background:var(--good)}
.vd{font-weight:600} .vd.good{color:var(--good)} .vd.fair{color:var(--fair)} .vd.poor{color:var(--poor)}
button.x{background:transparent;color:var(--mute);border:1px solid var(--line);padding:10px 12px}
.upd{font-size:13px;font-weight:600;color:var(--mute);white-space:nowrap}
.upd.ok{color:var(--good)} .upd.bad{color:var(--poor);white-space:normal}
.tag{font-size:11px;font-weight:600;padding:2px 7px;border-radius:99px;background:var(--bg);border:1px solid var(--line);color:var(--mute);margin-left:6px;vertical-align:1px}
.hint{color:var(--mute);font-size:13px;margin:8px 0 0}
.empty{color:var(--mute);padding:6px 0 14px}
.banner{border-radius:12px;padding:14px 18px;margin-bottom:14px;background:var(--fair-bg);color:var(--ink);border:1px solid var(--line);display:flex;gap:12px;align-items:center;justify-content:space-between}
.big{font-size:44px;font-weight:700;letter-spacing:-.03em;font-variant-numeric:tabular-nums}
.big small{font-size:18px;color:var(--mute);font-weight:500}
.bar{height:8px;background:var(--bg);border-radius:99px;overflow:hidden;margin:12px 0}
.bar i{display:block;height:100%;background:var(--accent);width:0;transition:width .4s}
.phases{display:flex;gap:6px;flex-wrap:wrap;font-size:13px}
.phases span{padding:4px 10px;border-radius:99px;background:var(--bg);color:var(--mute)}
.phases span.on{background:var(--accent);color:var(--accent-ink)}
.phases span.ok{color:var(--good)}
canvas{width:100%;height:170px;display:block;margin-top:10px}
.legend{display:flex;flex-wrap:wrap;gap:6px 16px;font-size:13px;color:var(--mute);margin-top:6px}
.legend i{display:inline-block;width:14px;height:3px;border-radius:2px;margin-right:6px;vertical-align:3px}
.verdict{border-radius:12px;padding:20px;margin-bottom:14px}
.verdict h3{margin:0 0 4px;font-size:24px;letter-spacing:-.02em}
.verdict.good{background:var(--good-bg)} .verdict.good h3{color:var(--good)}
.verdict.fair{background:var(--fair-bg)} .verdict.fair h3{color:var(--fair)}
.verdict.poor{background:var(--poor-bg)} .verdict.poor h3{color:var(--poor)}
.verdict.practice{background:var(--card);border:1px dashed var(--accent)} .verdict.practice h3{color:var(--accent)}
.ctype{margin-top:14px} .ctype select{margin-top:6px}
.practiceBox{display:flex;gap:12px;align-items:center;justify-content:space-between;margin-top:14px;padding-top:14px;border-top:1px solid var(--line)}
.verdict ul{margin:6px 0 0;padding-left:20px} .verdict li{margin:6px 0}
.nh{margin-top:14px;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--mute)}
.nh.poor{color:var(--poor)} .nh.fair{color:var(--fair)}
.metrics{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:10px}
.m{border:1px solid var(--line);border-radius:10px;padding:12px 14px;border-left:5px solid var(--line)}
.m.good{border-left-color:var(--good)} .m.fair{border-left-color:var(--fair)} .m.poor{border-left-color:var(--poor)}
.m .l{font-size:13px;color:var(--mute)}
.m .v{font-size:26px;font-weight:700;font-variant-numeric:tabular-nums}
.m .v small{font-size:14px;color:var(--mute);font-weight:500}
.m .e{font-size:12px;color:var(--mute)}
.m .g{float:right;font-size:11px;font-weight:700;text-transform:uppercase;padding:2px 8px;border-radius:99px}
.m.good .g{background:var(--good-bg);color:var(--good)} .m.fair .g{background:var(--fair-bg);color:var(--fair)} .m.poor .g{background:var(--poor-bg);color:var(--poor)}
table{width:100%;border-collapse:collapse;font-size:14px}
th,td{text-align:left;padding:8px 6px;border-bottom:1px solid var(--line);vertical-align:top}
th{color:var(--mute);font-weight:600;font-size:12px;text-transform:uppercase;letter-spacing:.04em}
td.num{font-variant-numeric:tabular-nums;white-space:nowrap}
details summary{cursor:pointer;font-weight:600}
#fixes h3{font-size:18px;margin:22px 0 4px}
.fix{border:1px solid var(--line);border-radius:10px;padding:12px 14px;margin-top:10px}
.fix b{display:block;margin-bottom:6px}
.fix ol{margin:0;padding-left:20px} .fix li{margin:5px 0}
.err{background:var(--poor-bg);color:var(--poor);border-radius:8px;padding:12px 14px;margin-top:12px}
.meta{font-size:13px;color:var(--mute);margin-top:12px}
.hide{display:none!important}
@media (max-width:560px){ .row.wrap{flex-wrap:wrap} .row.wrap button{width:100%} .big{font-size:36px} }
</style>
</head>
<body>
<main>
  <header>
    <h1>Net<span>Proof</span></h1>
    <div class="row" style="width:auto;gap:12px"><div class="me" id="me">This computer: Mac.agdon.net ¬∑ v1.7.5</div><button class="ghost" id="quit" style="padding:6px 12px;font-size:13px">Quit NetProof</button></div>
  </header>

  <div id="updBanner" class="banner hide" data-fp=""></div>
  <div id="incoming" class="banner hide"></div>

  <section class="card" id="setup">
    <h2><span class="step">1</span>Which connection should be tested?</h2>
    <div id="ifaceBox" data-fp="[{&quot;name&quot;:&quot;en0&quot;,&quot;ip&quot;:&quot;172.29.12.240&quot;,&quot;kind&quot;:&quot;wifi&quot;,&quot;linkMbps&quot;:0,&quot;desc&quot;:&quot;Wi-Fi&quot;,&quot;label&quot;:&quot;Wi-Fi: en0  (172.29.12.240)&quot;}]"><div><b>Wi-Fi: en0  (172.29.12.240)</b></div></div>
    <p class="hint" id="ifaceHint">This is the only network connection on this computer.</p>
  </section>

  <section class="card" id="pick">
    <h2><span class="step">2</span>Pick the other computer</h2>
    <p class="hint" style="margin:-4px 0 10px">NetProof must be running on the other computer too. Nothing to set up there: it answers automatically.</p>
    <div id="peers"><div class="empty">Looking for other computers running NetProof on your network‚Ä¶ If the other one is on a VPN or a different network, type its address below.</div></div>
    <div id="recentBox" class="">
      <h2 style="margin:16px 0 4px">Tested before</h2>
      <div id="recent">
    <div class="peer">
      <div class="n"><b><span class="dot on" title="NetProof is running there now"></span>M5KVK-Remote</b>
        <small>10.29.5.5 ¬∑ 2026-11-22 12:12 ¬∑ last result: <span class="vd poor">problems</span> ¬∑ NetProof 1.7.5</small></div>
      
      <button data-t="10.29.5.5" class="go">Test</button>
      <button data-t="10.29.5.5" class="x" title="Forget this computer">√ó</button>
    </div></div>
    </div>
    <div class="row wrap" style="margin-top:6px">
      <input id="target" placeholder="Or type its address or name: 192.168.1.50, 100.101.102.103 or a Tailscale name like boathouse2" autocomplete="off">
      <button id="go">Start test</button>
    </div>
    <div class="ctype">
      <label for="ptype"><b>What kind of connection is this?</b></label>
      <select id="ptype" data-fp="&lt;option value=&quot;auto&quot;&gt;Automatic (recommended)&lt;/option&gt;&lt;option value=&quot;1g&quot;&gt;Same building, wired, gigabit (1 Gb/s)&lt;/option&gt;&lt;option value=&quot;100m&quot;&gt;Same building, wired, 100 Mb/s&lt;/option&gt;&lt;option value=&quot;wifi&quot;&gt;Wi-Fi&lt;/option&gt;&lt;option value=&quot;vpn&quot;&gt;VPN, Tailscale, remote site or internet&lt;/option&gt;"><option value="auto">Automatic (recommended)</option><option value="1g">Same building, wired, gigabit (1 Gb/s)</option><option value="100m">Same building, wired, 100 Mb/s</option><option value="wifi">Wi-Fi</option><option value="vpn">VPN, Tailscale, remote site or internet</option></select>
      <p class="hint" style="margin-top:4px">This sets what ‚Äúgood‚Äù means. Automatic works it out from the addresses and the delay; pick one if you know better.</p>
    </div>
    <p class="hint">The test takes about 45 seconds: delay &amp; jitter, packet size, TCP speed both ways, then a steady UDP stream both ways (like real-time audio and VoIP).</p>
    <div class="practiceBox">
      <div><b>New to NetProof?</b><br><span class="hint" style="margin:0">Try a practice run on just this computer. No second computer needed; the numbers are not graded.</span></div>
      <button class="ghost" id="practice">Practice run</button>
    </div>
  </section>

  <section class="card hide" id="run">
    <h2 id="runTitle">Testing with 10.29.5.5</h2>
    <div class="phases" id="phases"><span class="ok">‚úì Connect</span><span class="ok">‚úì Delay &amp; jitter</span><span class="ok">‚úì Packet size</span><span class="ok">‚úì Download</span><span class="ok">‚úì Upload</span><span class="ok">‚úì UDP stream in</span><span class="on">UDP stream out</span></div>
    <div class="row" style="justify-content:space-between;align-items:flex-end;margin-top:12px">
      <div class="big" id="live">2.3 <small>Mb/s UDP stream Mac.agdon.net ‚Üí M5KVK-Remote at 2.3 Mb/s</small></div>
      <button class="ghost" id="cancel">Cancel</button>
    </div>
    <div class="bar"><i id="prog" style="width: 99%;"></i></div>
    <canvas id="chart" width="1580" height="340"></canvas>
    <div id="runErr" class="err hide"></div>
  </section>

  <section id="results" class="">
    <div class="verdict poor" id="verdict"><h3>You will notice problems on this connection</h3><div class="nh poor">You will notice</div><ul><li>You will hear it: expect clicks, dropouts and gaps in live audio. 88 of 1917 packets of a steady 2.3 Mb/s stream from M5KVK-Remote to Mac.agdon.net were lost (4.59%), and real-time audio cannot be resent.</li><li>Everything gets laggy while someone downloads or uploads something big: delay went from 73.8 ms to 866.0 ms when the link was full ("bufferbloat"). Remote control and audio will lag at those times.</li></ul><div class="nh fair">You may notice</div><ul><li>Live audio will work, but video or file transfers may struggle: from M5KVK-Remote to Mac.agdon.net the link carried 3.3 Mb/s.</li><li>Live audio will work, but video or file transfers may struggle: from Mac.agdon.net to M5KVK-Remote the link carried 3.6 Mb/s.</li><li>Conversations and remote control will feel laggy: every action takes 73.8 ms to reach the other end and come back. Above about 50 ms people notice it: talking over each other on calls, and slow response in remote control.</li><li>Live audio may stutter: the delay keeps changing by about 11.9 ms. Raising the jitter or network buffer in your audio or VoIP software hides this, at the cost of a little more delay.</li></ul><div class="nh info">Good to know</div><ul><li>81 stream packets arrived out of order. Some apps treat these as lost. Common on VPNs that use several paths.</li><li>This test went through a VPN or the internet, so speed depends on both internet connections. What matters most here is delay, jitter and loss.</li></ul></div>
    <section class="card">
      <div class="row" style="justify-content:space-between;margin-bottom:12px;flex-wrap:wrap">
        <h2 style="margin:0">Results</h2>
        <div class="row" style="width:auto" id="cmpBox">
          <span class="me">Compare against</span>
          <select id="profile" style="width:auto" data-fp="&lt;option value=&quot;auto&quot;&gt;Automatic (VPN / remote site / Internet)&lt;/option&gt;&lt;option value=&quot;1g&quot;&gt;1 Gb/s wired LAN&lt;/option&gt;&lt;option value=&quot;100m&quot;&gt;100 Mb/s wired LAN&lt;/option&gt;&lt;option value=&quot;wifi&quot;&gt;Wi-Fi&lt;/option&gt;&lt;option value=&quot;vpn&quot;&gt;VPN / remote site / Internet&lt;/option&gt;"><option value="auto">Automatic (VPN / remote site / Internet)</option><option value="1g">1 Gb/s wired LAN</option><option value="100m">100 Mb/s wired LAN</option><option value="wifi">Wi-Fi</option><option value="vpn">VPN / remote site / Internet</option></select>
        </div>
      </div>
      <div class="metrics" id="metrics">
    <div class="m fair">
      <span class="g">Noticeable</span>
      <div class="l">Speed  M5KVK-Remote ‚Üí Mac.agdon.net</div>
      <div class="v">3.3 <small>Mb/s</small></div>
      <div class="e">noticeably slow below 10.0 Mb/s</div>
    </div>
    <div class="m fair">
      <span class="g">Noticeable</span>
      <div class="l">Speed  Mac.agdon.net ‚Üí M5KVK-Remote</div>
      <div class="v">3.6 <small>Mb/s</small></div>
      <div class="e">noticeably slow below 10.0 Mb/s</div>
    </div>
    <div class="m fair">
      <span class="g">Noticeable</span>
      <div class="l">Delay (round trip)</div>
      <div class="v">73.8 <small>ms</small></div>
      <div class="e">felt above 50 ms</div>
    </div>
    <div class="m fair">
      <span class="g">Noticeable</span>
      <div class="l">Jitter</div>
      <div class="v">11.9 <small>ms</small></div>
      <div class="e">heard above 5 ms</div>
    </div>
    <div class="m poor">
      <span class="g">Bad</span>
      <div class="l">Extra delay when busy</div>
      <div class="v">792.2 <small>ms</small></div>
      <div class="e">felt above 50 ms</div>
    </div>
    <div class="m poor">
      <span class="g">Bad</span>
      <div class="l">Stream loss (2.3 Mb/s UDP)</div>
      <div class="v">4.59 <small>%</small></div>
      <div class="e">heard above 0.05 %</div>
    </div>
    <div class="m fair">
      <span class="g">Noticeable</span>
      <div class="l">Stream jitter</div>
      <div class="v">5.78 <small>ms</small></div>
      <div class="e">heard above 5 ms</div>
    </div>
    <div class="m good">
      <span class="g">OK</span>
      <div class="l">Largest packet (MTU)</div>
      <div class="v">1500 <small>bytes</small></div>
      <div class="e">1500 normal, 1280+ fine</div>
    </div></div>
      <div id="resChartBox" class="">
        <h3 style="margin:16px 0 0">Speed during the test</h3>
        <canvas id="resChart" width="1580" height="340"></canvas>
        <div class="legend" id="resLegend"><span><i style="background:var(--chart)"></i>TCP M5KVK-Remote ‚Üí Mac.agdon.net</span><span><i style="background:var(--chart2)"></i>TCP Mac.agdon.net ‚Üí M5KVK-Remote</span><span><i style="background:var(--chart3)"></i>UDP stream, both ways (steady 2.3 Mb/s)</span></div>
      </div>
      <div class="meta" id="meta">Mac.agdon.net: en0 (Wi-Fi) &nbsp;¬∑&nbsp; M5KVK-Remote: Ethernet (wired, link 1 Gb/s)<br>
    Compared against <b>VPN / remote site / Internet</b> (automatic: the other computer is on a different network (10.29.5.5) and delay is 73.8 ms, so traffic goes through a router, VPN or the internet).<br>
    Delay ranged 45.64 to 341.62 ms over 300 UDP probes. Busy delay: 866.00 ms (download), 704.07 ms (upload).
    <br>UDP stream M5KVK-Remote ‚Üí Mac.agdon.net at 2.3 Mb/s: 1829 of 1917 packets arrived (4.59% lost), jitter 5.78 ms, 81 out of order.<br>UDP stream Mac.agdon.net ‚Üí M5KVK-Remote at 2.3 Mb/s: 1917 of 1917 packets arrived (0.00% lost), jitter 3.25 ms, 2 out of order.
    2026-11-22 12:11:34</div>
      <div id="fixes"><h3>How to fix it</h3><p class="hint" style="margin:0">Start at the top: each step is in the order most likely to help.</p><div class="fix"><b>1. Stop the connection getting laggy when it is busy (bufferbloat)</b><ol><li>In the router, turn on SQM / Smart Queue Management, "cake" or "fq_codel" (OpenWrt, pfSense, OPNsense, Ubiquiti and many others have it), and set it to about 90% of your real line speed.</li><li>If the router has no such setting, QoS that limits big downloads and uploads helps; turning it off on a router whose QoS is badly done can also help.</li><li>Schedule backups and large cloud sync for when you are not using live audio.</li></ol></div><div class="fix"><b>2. Reduce jitter</b><ol><li>Fix the packet loss and the lag when busy first (above); they are the usual cause of jitter.</li><li>Use a cable instead of Wi-Fi for anything real-time; the Wi-Fi steps above help when you cannot.</li><li>In your audio, VoIP or streaming software, increase the network or jitter buffer a little. More buffer means a bit more delay but no dropouts.</li><li>Over the internet, jitter often comes from the slowest upload link. Ask your provider about line quality, or test at a quieter time of day to compare.</li></ol></div><div class="fix"><b>3. Make the VPN path cleaner</b><ol><li>Test each site's internet connection on its own (a normal speed test at both ends). The VPN can never be faster or cleaner than the worse of the two.</li><li>Make sure both ends connect directly rather than through a relay server.</li><li>Check the VPN endpoint (router or PC) is not overloaded: encryption on a small router can be the bottleneck.</li></ol></div></div>
      <div class="row" style="margin-top:14px;gap:8px;flex-wrap:wrap">
        <button class="ghost" id="copy" data-which="">Copy report</button>
        <a id="save" href="/api/report.txt"><button class="ghost">Save report</button></a>
        <button class="ghost" id="askAI" title="Opens a window with a ready-made prompt to paste into ChatGPT, Claude or another AI assistant" data-which="">Ask an AI</button>
        <button class="ghost" id="again">Test again</button>
      </div>
    </section>
  </section>

  <section class="card">
    <details id="refBox">
      <summary>What does a healthy network look like, and when would I notice?</summary>
      <p class="hint">NetProof only calls something out when you would actually hear or feel it. The first columns are what a healthy network measures; the last ones are where people start to notice. A wired link never shows its full label speed: about 6% goes to Ethernet, IP and TCP headers.</p>
      <table>
        <thead><tr><th></th><th>Healthy 100 Mb/s LAN</th><th>Healthy 1 Gb/s LAN</th><th>Healthy VPN / Tailscale</th><th>You may notice</th><th>You will notice</th></tr></thead>
        <tbody>
          <tr><td>Speed, each direction</td><td class="num">90 to 95 Mb/s</td><td class="num">900 to 945 Mb/s</td><td>depends on both internet links</td><td class="num">below 80 / 700 / 10 Mb/s</td><td class="num">below 40 / 300 / 3 Mb/s</td></tr>
          <tr><td>Delay (round trip)</td><td class="num">under 1 ms</td><td class="num">under 1 ms</td><td class="num">10 to 40 ms</td><td class="num">above 50 ms</td><td class="num">above 150 ms</td></tr>
          <tr><td>Jitter</td><td class="num">under 1 ms</td><td class="num">under 1 ms</td><td class="num">under 3 ms</td><td class="num">above 5 ms</td><td class="num">above 15 ms</td></tr>
          <tr><td>Stream loss</td><td class="num">0 %</td><td class="num">0 %</td><td class="num">0 %</td><td class="num">above 0.05 %</td><td class="num">above 0.5 %</td></tr>
          <tr><td>Extra delay when busy</td><td class="num">under 20 ms</td><td class="num">under 10 ms</td><td class="num">under 30 ms</td><td class="num">above 50 ms</td><td class="num">above 150 ms</td></tr>
          <tr><td>Largest packet (MTU)</td><td class="num">1500</td><td class="num">1500</td><td class="num">1280 to 1420</td><td class="num">below 1280</td><td></td></tr>
        </tbody>
      </table>
      <p class="hint">What you notice: speed shows up in file copies; delay makes calls and remote control feel laggy, with people talking over each other; jitter and loss are heard as clicks, stutter and dropouts in live audio; busy delay makes everything lag while something big is transferring.</p>
      <p class="hint"><b>Common culprits:</b> a cable that only connects at 100 Mb/s (damaged, or only 4 of 8 wires), a cheap or overheating switch, Wi-Fi in the path when you thought it was wired, a busy network during the test, or a VPN relaying traffic through a far away server.</p>
    </details>
  </section>
</main>

<script>
const $ = id => document.getElementById(id);
let S = null, lastFp = "", userTyped = false;

async function api(path, body){
  const r = await fetch(path, {method:"POST", headers:{"Content-Type":"application/json"}, body:JSON.stringify(body||{})});
  const j = await r.json().catch(()=>({}));
  if(!r.ok) throw new Error(j.error || r.statusText);
  return j;
}
const esc = s => String(s ?? "").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const fmtMbps = v => v >= 100 ? Math.round(v) : v.toFixed(1);
const fmtVal = m => m.unit === "bytes" ? Math.round(m.value) : m.unit === "Mb/s" ? fmtMbps(m.value) : (m.unit === "%" ? m.value.toFixed(2) : (m.value < 10 ? m.value.toFixed(2) : m.value.toFixed(1)));
const gradeWord = {good:"OK", fair:"Noticeable", poor:"Bad", info:"Info"};

const PTYPE_LABEL = {"1g":"Same building, wired, gigabit (1 Gb/s)","100m":"Same building, wired, 100 Mb/s","wifi":"Wi-Fi","vpn":"VPN, Tailscale, remote site or internet"};
function renderPtype(){
  const sel = $("ptype");
  const opts = `<option value="auto">Automatic (recommended)</option>` + S.profiles.map(p => `<option value="${p.key}">${esc(PTYPE_LABEL[p.key] || p.name)}</option>`).join("");
  if (sel.dataset.fp !== opts){ sel.innerHTML = opts; sel.dataset.fp = opts; }
  if (document.activeElement !== sel) sel.value = S.profile;
}

function renderIfaces(){
  const ifs = S.interfaces || [];
  const box = $("ifaceBox");
  const fp = JSON.stringify(ifs) + S.bindIP;
  if (box.dataset.fp === fp) return;
  box.dataset.fp = fp;
  if (ifs.length <= 1){
    box.innerHTML = ifs.length ? `<div><b>${esc(ifs[0].label)}</b></div>` : `<div class="empty">No network connection found.</div>`;
    $("ifaceHint").textContent = ifs.length ? "This is the only network connection on this computer." : "";
    return;
  }
  let o = `<option value="">Automatic (let ${esc(S.os === "windows" ? "Windows" : "the computer")} choose)</option>`;
  for (const i of ifs) o += `<option value="${esc(i.ip)}" ${i.ip === S.bindIP ? "selected" : ""}>${esc(i.label)}</option>`;
  box.innerHTML = `<select id="iface">${o}</select>`;
  $("iface").onchange = e => api("/api/bind", {ip:e.target.value}).then(poll);
  $("ifaceHint").textContent = "This computer has more than one connection. To test over Tailscale or a VPN, pick it here and use the other computer's VPN address.";
}

// The other computer's version, for the line under its name.
function verText(p){
  if (!p.version) return "";
  if (p.update === "manual") return ` &middot; NetProof ${esc(p.version)}: install ${esc(S.version)} there once, then it updates itself`;
  if ((p.update || "").startsWith("failed: ")) return ` &middot; NetProof ${esc(p.version)}: the update did not work (${esc(p.update.slice(8))})`;
  return ` &middot; NetProof ${esc(p.version)}`;
}

// The Update button, or how updating the other computer is going.
function updCtl(target, p){
  const dis = S.test.running ? "disabled" : "";
  switch (true){
    case p.update === "available":
      return `<button class="ghost upd-go" data-t="${esc(target)}" ${dis} title="Update NetProof on ${esc(p.host || target)} from ${esc(p.version)} to ${esc(S.version)}">Update to ${esc(S.version)}</button>`;
    case p.update === "updating":
      return `<span class="upd">Updating&hellip;</span>`;
    case p.update === "updated":
      return `<span class="upd ok">Updated to ${esc(p.version)}</span>`;
    case (p.update || "").startsWith("failed: "):
      return `<span class="upd bad" title="${esc(p.update.slice(8))}">Update failed</span><button class="ghost upd-go" data-t="${esc(target)}" ${dis}>Try again</button>`;
  }
  return "";
}

function wireUpd(box){
  for (const b of box.querySelectorAll("button.upd-go")) b.onclick = () => {
    b.disabled = true;
    api("/api/update-peer", {target: b.dataset.t}).then(poll).catch(e => { alert(e.message); b.disabled = false; });
  };
}

function renderPeers(){
  const ps = S.peers || [];
  const fp = JSON.stringify(ps.map(p=>[p.addr,p.host,p.via,p.version,p.update])) + S.test.running + S.version;
  if (fp === lastFp) return;
  lastFp = fp;
  if (!ps.length){
    $("peers").innerHTML = `<div class="empty">Looking for other computers running NetProof on your network&hellip; If the other one is on a VPN or a different network, type its address below.</div>`;
    return;
  }
  $("peers").innerHTML = ps.map(p => `
    <div class="peer">
      <div class="n"><b>${esc(p.host)}<span class="tag">${esc(p.via)}</span></b><small>${p.dns ? esc(p.dns) + " &middot; " : ""}${esc(p.addr)} &middot; ${esc(p.os)}${verText(p)}</small></div>
      ${updCtl(p.addr, p)}
      <button class="test" data-addr="${esc(p.addr)}" ${S.test.running ? "disabled" : ""}>Test</button>
    </div>`).join("");
  for (const b of $("peers").querySelectorAll("button.test")) b.onclick = () => start(b.dataset.addr);
  wireUpd($("peers"));
}

let lastRecentFp = "";
function renderRecent(){
  const rs = S.recent || [];
  $("recentBox").classList.toggle("hide", !rs.length);
  const fp = JSON.stringify(rs) + S.test.running + S.version;
  if (fp === lastRecentFp) return;
  lastRecentFp = fp;
  const vword = {good:"healthy", fair:"so-so", poor:"problems"};
  $("recent").innerHTML = rs.map(r => `
    <div class="peer">
      <div class="n"><b><span class="dot ${r.online ? "on" : ""}" title="${r.online ? "NetProof is running there now" : "Not answering right now"}"></span>${esc(r.host || r.target)}</b>
        <small>${esc(r.target)}${r.ip && r.ip !== r.target ? " (" + esc(r.ip) + ")" : ""} &middot; ${esc(r.when)}${r.verdict ? ` &middot; last result: <span class="vd ${esc(r.verdict)}">${vword[r.verdict] || esc(r.verdict)}</span>` : " &middot; tested this computer"}${r.online ? verText(r) : " &middot; offline"}</small></div>
      ${r.online ? updCtl(r.target, r) : ""}
      <button data-t="${esc(r.target)}" class="go" ${S.test.running ? "disabled" : ""}>Test</button>
      <button data-t="${esc(r.target)}" class="x" title="Forget this computer">&times;</button>
    </div>`).join("");
  for (const b of $("recent").querySelectorAll("button.go")) b.onclick = () => start(b.dataset.t);
  for (const b of $("recent").querySelectorAll("button.x")) b.onclick = () => api("/api/forget", {target: b.dataset.t}).then(poll);
  wireUpd($("recent"));
}

async function start(target){
  $("runErr").classList.add("hide");
  try { await api("/api/start", {target}); $("results").classList.add("hide"); poll(); }
  catch(e){ $("run").classList.remove("hide"); $("runErr").textContent = e.message; $("runErr").classList.remove("hide"); }
}

const PH = [["connect","Connect"],["update","Updating"],["latency","Delay & jitter"],["mtu","Packet size"],["download","Download"],["upload","Upload"],["udpdown","UDP stream in"],["udpup","UDP stream out"]];
const THR = ["download","upload","udpdown","udpup"];
function renderRun(){
  const t = S.test;
  const show = t.running || t.phase === "error";
  $("go").disabled = t.running; $("practice").disabled = t.running; // always, even when the run card is hidden
  $("run").classList.toggle("hide", !show);
  if (!show) return;
  $("runTitle").textContent = t.running ? "Testing with " + t.target : "Test stopped";
  const ph = PH.filter(p => p[0] !== "update" || t.phase === "update" || (t.samples||[]).some(x => x.phase === "update"));
  const idx = ph.findIndex(p => p[0] === t.phase);
  $("phases").innerHTML = ph.map((p,i) => `<span class="${i === idx ? "on" : (i < idx ? "ok" : "")}">${i < idx ? "&#10003; " : ""}${p[1]}</span>`).join("");
  $("prog").style.width = (t.progress*100).toFixed(1) + "%";
  if (t.phase === "latency") $("live").innerHTML = `${(t.lastRtt||0).toFixed(2)} <small>ms delay</small>`;
  else if (THR.includes(t.phase)) $("live").innerHTML = `${fmtMbps(t.currentMbps||0)} <small>Mb/s ${esc(t.phaseLabel)}</small>`;
  else $("live").innerHTML = `<small>${esc(t.phaseLabel || "")}&hellip;</small>`;
  $("cancel").classList.toggle("hide", !t.running);
  if (t.error){ $("runErr").textContent = t.error; $("runErr").classList.remove("hide"); }
  drawChart($("chart"), t.samples || []);
}

// noLabels: the results graph has its own legend below it.
function drawChart(c, samples, noLabels){
  const dpr = window.devicePixelRatio || 1;
  const w = c.clientWidth, h = c.clientHeight;
  if (!w) return;
  c.width = w*dpr; c.height = h*dpr;
  const g = c.getContext("2d"); g.scale(dpr,dpr); g.clearRect(0,0,w,h);
  const cs = getComputedStyle(document.documentElement);
  const line = cs.getPropertyValue("--line"), mute = cs.getPropertyValue("--mute");
  // Leave out the first second of each TCP phase, as the measurement does:
  // the upload is counted as it is written to the socket, so it starts with
  // a burst of the send buffers filling, not traffic on the network.
  const first = {};
  for (const s of samples) if (!(s.phase in first)) first[s.phase] = s.t;
  const thr = samples.filter(s => THR.includes(s.phase) && !((s.phase === "download" || s.phase === "upload") && s.t - first[s.phase] < 1))
    .map(s => ({...s, mbps: s.mbps || 0}));
  // Time axis from the first speed sample to the last (at least 29 s, the
  // TCP part), so all four phases fit.
  const t0 = thr.length ? thr[0].t : 0, T = Math.max(29, thr.length ? thr[thr.length-1].t - t0 : 0);
  const maxM = Math.max(10, ...thr.map(s => s.mbps)) * 1.15;
  const x = t => 40 + (w-50) * Math.min(t-t0,T)/T, y = v => h-14 - (h-34) * v/maxM;
  g.strokeStyle = line; g.fillStyle = mute; g.font = "11px system-ui"; g.lineWidth = 1;
  for (let i=0;i<=4;i++){ const v = maxM*i/4; g.beginPath(); g.moveTo(40,y(v)); g.lineTo(w-10,y(v)); g.stroke(); g.fillText(v>=100?Math.round(v):v.toFixed(0), 4, y(v)+4); }
  g.fillText("Mb/s", 4, 9);
  for (const ph of THR){
    const pts = thr.filter(s => s.phase === ph && s.mbps > 0);
    if (!pts.length) continue;
    g.strokeStyle = cs.getPropertyValue({download:"--chart",upload:"--chart2"}[ph] || "--chart3"); g.lineWidth = 2; g.beginPath();
    pts.forEach((s,i) => i ? g.lineTo(x(s.t),y(s.mbps)) : g.moveTo(x(s.t),y(s.mbps))); g.stroke();
    if (!noLabels){ g.fillStyle = g.strokeStyle; g.fillText({download:"download",upload:"upload",udpdown:"UDP in",udpup:"UDP out"}[ph], x(pts[0].t)+4, 12); }
  }
}

function renderResult(res, isIncoming){
  $("results").classList.toggle("hide", !res);
  if (!res) return;
  const v = $("verdict");
  v.className = "verdict " + res.verdict;
  const who = isIncoming ? `<p style="margin:0 0 8px">Test run by <b>${esc(res.localHost)}</b> against this computer.</p>` : "";
  const notes = (res.notes && res.notes.length) ? res.notes : (res.findings || []).map(t => ({level:"", text:t}));
  const heads = {poor:"You will notice", fair:"You may notice", info:"Good to know"};
  let html = "", lastLevel = null;
  for (const n of notes){
    if (n.level !== lastLevel){
      if (lastLevel !== null) html += "</ul>";
      html += (heads[n.level] ? `<div class="nh ${n.level}">${heads[n.level]}</div>` : "") + "<ul>";
      lastLevel = n.level;
    }
    html += `<li>${esc(n.text)}</li>`;
  }
  if (lastLevel !== null) html += "</ul>";
  v.innerHTML = `<h3>${esc(res.headline)}</h3>${who}${html}`;
  $("metrics").innerHTML = res.metrics.map(m => `
    <div class="m ${m.grade}">
      ${m.grade !== "info" ? `<span class="g">${gradeWord[m.grade]}</span>` : ""}
      <div class="l">${esc(m.label)}</div>
      <div class="v">${fmtVal(m)} <small>${esc(m.unit)}</small></div>
      <div class="e">${esc(m.expect)}</div>
    </div>`).join("");
  const side = (iface, kind, link) => iface ? `${esc(iface)} (${{wired:"wired",wifi:"Wi-Fi",vpn:"VPN",virtual:"virtual"}[kind]||kind}${link>0 && kind!=="vpn" ? ", link " + (link>=1000 ? link/1000 + " Gb/s" : link + " Mb/s") : ""})` : "unknown";
  $("meta").innerHTML = `${res.remoteName ? "Tested " + esc(res.remoteName) + " (" + esc(res.remoteIP) + ")<br>" : ""}${esc(res.localHost)}: ${side(res.localIface,res.localKind,res.localLinkMbps)} &nbsp;&middot;&nbsp; ${esc(res.remoteHost)}: ${side(res.remoteIface,res.remoteKind,res.remoteLinkMbps)}<br>
    Compared against <b>${esc(res.profileName)}</b>${res.profileAuto && res.autoReason ? " (automatic: " + esc(res.autoReason) + ")" : (res.practice ? "" : " (your choice)")}.<br>
    Delay ranged ${res.idleRttMin.toFixed(2)} to ${res.idleRttMax.toFixed(2)} ms over ${res.sent} ${esc(res.latencyMethod)} probes. Busy delay: ${res.downLoadedRtt.toFixed(2)} ms (download), ${res.upLoadedRtt.toFixed(2)} ms (upload).
    ${udpLine(res.udpDown, res.remoteHost + " ‚Üí " + res.localHost, res.udpRateMbps)}${udpLine(res.udpUp, res.localHost + " ‚Üí " + res.remoteHost, res.udpRateMbps)}
    ${esc(res.time)}`;
  const fx = res.fixes || [];
  $("fixes").innerHTML = fx.length ? `<h3>How to fix it</h3><p class="hint" style="margin:0">Start at the top: each step is in the order most likely to help.</p>` +
    fx.map((f,i) => `<div class="fix"><b>${i+1}. ${esc(f.title)}</b><ol>${f.steps.map(s => `<li>${esc(s)}</li>`).join("")}</ol></div>`).join("") : "";
  $("cmpBox").classList.toggle("hide", !!res.practice);
  const sel = $("profile");
  const want = (S.profile === "auto" ? "auto" : res.profileKey);
  const opts = `<option value="auto">Automatic${S.profile==="auto" ? " (" + esc(res.profileName) + ")" : ""}</option>` + S.profiles.map(p => `<option value="${p.key}">${esc(p.name)}</option>`).join("");
  if (sel.dataset.fp !== opts){ sel.innerHTML = opts; sel.dataset.fp = opts; }
  if (document.activeElement !== sel) sel.value = want;
  $("save").href = "/api/report.txt" + (isIncoming ? "?which=incoming" : "");
  $("copy").dataset.which = isIncoming ? "incoming" : "";
  $("askAI").dataset.which = isIncoming ? "incoming" : "";
  shownRes = res;
  drawResChart();
}

// The speed graph kept with the result shown (results from 1.7.3 on).
let shownRes = null;
function drawResChart(){
  const res = shownRes;
  const has = !!(res && res.samples && res.samples.length);
  $("resChartBox").classList.toggle("hide", !has);
  if (!has) return;
  drawChart($("resChart"), res.samples, true);
  const a = esc(res.remoteHost), b = esc(res.localHost);
  const items = [["--chart", `TCP ${a} ‚Üí ${b}`], ["--chart2", `TCP ${b} ‚Üí ${a}`], ["--chart3", `UDP stream, both ways (steady ${res.udpRateMbps} Mb/s)`]];
  const html = items.map(i => `<span><i style="background:var(${i[0]})"></i>${i[1]}</span>`).join("");
  if ($("resLegend").innerHTML !== html) $("resLegend").innerHTML = html;
}

function udpLine(st, dir, rate){
  if (!st) return "";
  return `<br>UDP stream ${esc(dir)} at ${rate} Mb/s: ${st.received} of ${st.sent} packets arrived (${st.lossPct.toFixed(2)}% lost), jitter ${st.jitterMs.toFixed(2)} ms, ${st.outOfOrder} out of order.`;
}

function renderUpdate(){
  const b = $("updBanner"), st = S.updateState || "";
  let html = "";
  if (st.startsWith("updating") || st.startsWith("restarting")){
    html = `<div>Updating NetProof&hellip; the page reconnects by itself in a few seconds.</div>`;
  } else if (st.startsWith("failed")){
    html = `<div>The update did not work: ${esc(st.slice(8))}</div><button class="ghost" id="updGo">Try again</button>`;
  } else if (S.latest){
    html = `<div><b>NetProof ${esc(S.latest)} is available.</b> This computer runs ${esc(S.version)}.</div><button id="updGo">Update now</button>`;
  }
  b.classList.toggle("hide", !html);
  if (b.dataset.fp === html) return; // keep the button stable between polls
  b.dataset.fp = html;
  b.innerHTML = html;
  const go = $("updGo"); if (go) go.onclick = () => api("/api/update").then(poll).catch(e => alert(e.message));
}

function renderIncoming(){
  const inc = S.incoming, b = $("incoming");
  if (!inc || S.test.running){ b.classList.add("hide"); return; }
  const fresh = (Date.now() - new Date(inc.started).getTime()) < 60000;
  if (inc.result){ b.classList.add("hide"); return; }
  if (!fresh){ b.classList.add("hide"); return; }
  b.innerHTML = `<div><b>${esc(inc.fromHost)}</b> (${esc(inc.fromIP)}) is testing this computer now. Results will show here in about 45 seconds.</div>`;
  b.classList.remove("hide");
}

async function poll(){
  try {
    const r = await fetch("/api/state", {cache:"no-store"});
    S = await r.json();
  } catch(e){ $("me").textContent = "NetProof has stopped. Start it again to continue."; return; }
  $("me").textContent = `This computer: ${S.host} ¬∑ v${S.version}`;
  renderIfaces(); renderPtype(); renderPeers(); renderRecent(); renderUpdate(); renderRun(); renderIncoming();
  // Show whichever result is newest: ours, or one the other side ran against us.
  let res = S.result, inc = false;
  if (S.incoming && S.incoming.result && (!res || S.incoming.result.time > res.time)){ res = S.incoming.result; inc = true; }
  renderResult(S.test.running ? null : res, inc);
  if (!userTyped && !$("target").value && S.test.target) $("target").value = S.test.target;
}

$("go").onclick = () => start($("target").value);
$("quit").onclick = () => { if (confirm("Stop NetProof on this computer? Other computers will not be able to test with it until you start it again.")) api("/api/quit").catch(() => {}); };
$("practice").onclick = () => start("127.0.0.1");
$("target").addEventListener("keydown", e => { userTyped = true; if (e.key === "Enter") start($("target").value); });
$("cancel").onclick = () => api("/api/cancel");
$("again").onclick = () => { const t = (S.result && !$("copy").dataset.which) ? S.test.target : (S.incoming ? S.incoming.fromIP : $("target").value); start(t || $("target").value); };
$("ptype").onchange = e => api("/api/profile", {profile:e.target.value}).then(poll);
$("profile").onchange = e => api("/api/profile", {profile:e.target.value}).then(poll);
$("copy").onclick = async () => {
  const txt = await (await fetch("/api/report.txt" + ($("copy").dataset.which ? "?which=incoming" : ""))).text();
  try { await navigator.clipboard.writeText(txt); $("copy").textContent = "Copied"; }
  catch { const ta = document.createElement("textarea"); ta.value = txt; document.body.appendChild(ta); ta.select(); document.execCommand("copy"); ta.remove(); $("copy").textContent = "Copied"; }
  setTimeout(() => $("copy").textContent = "Copy report", 1500);
};
$("askAI").onclick = () => window.open("/ai-prompt" + ($("askAI").dataset.which ? "?which=incoming" : ""), "netproof-ai", "width=900,height=820");
window.addEventListener("resize", () => { if (S) drawChart($("chart"), S.test.samples || []); drawResChart(); });
poll(); setInterval(poll, 500);
</script>


